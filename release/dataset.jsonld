{
  "@context": "https://schema.org/",
  "@type": "Dataset",
  "name": "Omarchy Plugin Observatory",
  "description": "Empirical security, lifecycle, and architecture audit dataset for 3,086 Omarchy Quattro plugins with 10,310 verified code evidence anchors.",
  "version": "1.0.0",
  "dateModified": "2026-09-14",
  "inLanguage": [
    "en",
    "ru"
  ],
  "isAccessibleForFree": true,
  "license": "https://opensource.org/licenses/MIT",
  "distribution": [
    {
      "@type": "DataDownload",
      "encodingFormat": "application/jsonl",
      "contentUrl": "data/plugins.jsonl",
      "name": "Plugin audit records"
    },
    {
      "@type": "DataDownload",
      "encodingFormat": "application/jsonl",
      "contentUrl": "data/evidence.jsonl",
      "name": "Evidence anchors"
    },
    {
      "@type": "DataDownload",
      "encodingFormat": "application/jsonl",
      "contentUrl": "data/claims.jsonl",
      "name": "Verified aggregate claims"
    },
    {
      "@type": "DataDownload",
      "encodingFormat": "application/json",
      "contentUrl": "data/patterns.json",
      "name": "Architectural and review patterns"
    }
  ]
}
