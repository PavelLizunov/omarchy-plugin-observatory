+                    sys.exit(1)
+                if total_pixels + (canvas_w * canvas_h) > MAX_DECODE_PIXELS_TOTAL:
+                    sys.stdout.write(json.dumps({"status": "error", "error": f"Total decoded pixels exceed limit ({total_pixels + canvas_w * canvas_h} > {MAX_DECODE_PIXELS_TOTAL})"}) + "\n")
+                    sys.exit(1)
